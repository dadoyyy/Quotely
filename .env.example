# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (needed from the first run of auth) ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used solely by the public approval route. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string (use the pooled "Transaction" URI for the app,
# the direct one for migrations).
DATABASE_URL=

# --- Google sign-in (optional, added after email login works) ---
# Configured in the Supabase dashboard under Authentication > Providers > Google,
# so the client ID and secret live there, not in this file.

# --- AI (Phase 5) ---
GEMINI_API_KEY=
AI_ENABLED=true
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=
# Optional. AI drafts per person per rolling 24h (default 30).
AI_DAILY_LIMIT=30

# --- Email (Phase 3) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Scheduled jobs (Phase 4) ---
# Any random string of 16+ characters. Vercel sends it as a Bearer token to /api/cron/daily.
# Without it the job refuses to run.
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
